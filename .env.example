# Push мэдэгдэл ажиллуулахад шаардлагатай 2 утга.
# Энэ файлыг .env нэрээр хуулж, доорх утгуудыг бөглөнө үү.
# (.env нь .gitignore-д орсон тул GitHub руу орохгүй.)

# Firebase Console → Project settings → Cloud Messaging → Web Push certificates → "Generate key pair"
VITE_VAPID_KEY=

# Vercel дээр deploy хийсний дараах функцийн хаяг
VITE_NOTIFY_ENDPOINT=https://<таны-vercel-төсөл>.vercel.app/api/notify
