rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isCouple() {
      return request.auth != null &&
        request.auth.token.email in ['andela@ankomeow.app', 'neko@ankomeow.app'];
    }
    function myKey() {
      return request.auth.token.email.split('@')[0];
    }

    match /rooms/ankomeow-couple/messages/{messageId} {
      allow read: if isCouple();
      allow create: if isCouple() && request.resource.data.sender == myKey();
      allow update: if isCouple();
      allow delete: if isCouple() && resource.data.sender == myKey();
    }

    match /rooms/ankomeow-couple/stats/{key} {
      allow read: if isCouple();
      allow write: if isCouple() && key == myKey();
    }

    match /rooms/ankomeow-couple/reads/{key} {
      allow read: if isCouple();
      allow write: if isCouple() && key == myKey();
    }

    match /rooms/ankomeow-couple/peeks/{key} {
      allow read: if isCouple() && key == myKey();
      allow write: if isCouple();
    }

    /* Chibi товшилт — хос бичиж, эзэн нь уншина (peeks-тэй ижил загвар) */
    match /rooms/ankomeow-couple/pokes/{key} {
      allow read: if isCouple() && key == myKey();
      allow write: if isCouple();
    }

    /* Push token — эзэн нь л өөрийнхөө төхөөрөмжийг бүртгэнэ.
       Сервер тал (firebase-admin) энэ дүрмийг тойрдог тул унших эрх өгөх шаардлагагүй. */
    match /rooms/ankomeow-couple/tokens/{key} {
      allow read, write: if isCouple() && key == myKey();
    }

    /* Хадгалсан чат — зөвхөн эзэн нь өөрийн хуулбарыг уншиж, бичнэ */
    match /rooms/ankomeow-couple/saved/{key}/items/{itemId} {
      allow read, write: if isCouple() && key == myKey();
    }

    /* Зурсан sticker сан — зөвхөн эзэн нь */
    match /rooms/ankomeow-couple/stickers/{key}/items/{itemId} {
      allow read, write: if isCouple() && key == myKey();
    }

    /* Чатын хүнд хавсралт (зураг, дуу). Зурвас нь зөвхөн blobId агуулна. */
    match /rooms/ankomeow-couple/blobs/{blobId} {
      allow read: if isCouple();
      allow create: if isCouple();
      allow delete: if isCouple();
    }

    /* Өдрийн асуулт — хоёулаа өөрийн хариултаа бичнэ */
    match /rooms/ankomeow-couple/qa/{dayId} {
      allow read, write: if isCouple();
    }

    /* Хамтын календарь — хоёулаа нэмж, устгана */
    match /rooms/ankomeow-couple/events/{eventId} {
      allow read, write: if isCouple();
    }

    /* Хадгалсан газрууд (geofence) — хоёулаа нэмж, устгана */
    match /rooms/ankomeow-couple/places/{placeId} {
      allow read, write: if isCouple();
    }

    /* Хосын нийтлэг огноо (танилцсан өдөр, төрсөн өдрүүд) — хоёулаа засна */
    match /rooms/ankomeow-couple/couple/{docId} {
      allow read, write: if isCouple();
    }

    /* Өдөр бүрийн биелэлт (streak) — хоёулаа өөрийн талбараа тэмдэглэнэ */
    match /rooms/ankomeow-couple/days/{dayId} {
      allow read: if isCouple();
      allow write: if isCouple();
    }

    /* Хүслийн жагсаалт — хос нь харна, эзэн нь л бичнэ */
    match /rooms/ankomeow-couple/wishes/{key}/items/{itemId} {
      allow read: if isCouple();
      allow write: if isCouple() && key == myKey();
    }

    /* Статус — хос нь уншина, эзэн нь л бичнэ */
    match /rooms/ankomeow-couple/profiles/{key} {
      allow read: if isCouple();
      allow write: if isCouple() && key == myKey();
    }

    /* Профайлын зураг — хос нь харна, эзэн нь л нэмж, устгана.
       Бүтэн хэмжээний зураг нь blobs дотор, энд зөвхөн жижиг хувилбар
       болон blobId сууна. */
    match /rooms/ankomeow-couple/posts/{key}/items/{itemId} {
      allow read: if isCouple();
      allow write: if isCouple() && key == myKey();
    }

    /* Бодит цагийн байршил — хос нь уншина, эзэн нь л бичнэ */
    match /rooms/ankomeow-couple/live/{key} {
      allow read: if isCouple();
      allow write: if isCouple() && key == myKey();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
